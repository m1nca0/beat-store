<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFA">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp">

        <!-- Заголовок -->
        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beat Store"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FF6200EE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="60dp" />

        <!-- Кнопки-вкладки -->
        <LinearLayout
            android:id="@+id/layoutTabs"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:background="#E8E8E8"
            app:cornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvLoginTitle">

            <Button
                android:id="@+id/btnTabLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Вход"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF6200EE"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnTabRegister"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Регистрация"
                android:textSize="14sp"
                android:textColor="#999999"
                android:backgroundTint="@android:color/transparent" />
        </LinearLayout>

        <!-- ====== ПОЛЯ ДЛЯ ВХОДА ====== -->
        <LinearLayout
            android:id="@+id/layoutLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutTabs">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLoginUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Имя пользователя"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLoginUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Пароль"
                app:passwordToggleEnabled="true"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLoginPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Выбор роли (для входа) -->
            <RadioGroup
                android:id="@+id/rgRoleLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:gravity="center">

                <RadioButton
                    android:id="@+id/rbCustomerLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Покупатель"
                    android:checked="true"
                    android:layout_marginEnd="32dp" />

                <RadioButton
                    android:id="@+id/rbProducerLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Продюсер" />
            </RadioGroup>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Войти"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF6200EE"
                android:layout_marginTop="24dp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- ====== ПОЛЯ ДЛЯ РЕГИСТРАЦИИ ====== -->
        <LinearLayout
            android:id="@+id/layoutRegister"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutTabs">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRegUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Имя пользователя"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRegEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Email"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRegPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Пароль"
                app:passwordToggleEnabled="true"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Выбор роли (для регистрации) -->
            <RadioGroup
                android:id="@+id/rgRoleReg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:gravity="center">

                <RadioButton
                    android:id="@+id/rbCustomerReg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Покупатель"
                    android:checked="true"
                    android:layout_marginEnd="32dp" />

                <RadioButton
                    android:id="@+id/rbProducerReg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Продюсер" />
            </RadioGroup>

            <!-- Поле artist_name (только для покупателя) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRegArtistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Имя артиста (псевдоним)"
                android:visibility="visible"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegArtistName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Зарегистрироваться"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF6200EE"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>